<?xml version="1.0" encoding="UTF-8"?>
<!-- WiX v4. Build via build-installer.ps1, which supplies Version, Payload and Icon. -->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="Cinnabar" Manufacturer="Cinnabar" Version="$(Version)"
           UpgradeCode="2A430447-F280-4F32-AFE9-F8A652811A04" Scope="perMachine" Compressed="yes">
    <MajorUpgrade DowngradeErrorMessage="A newer version of Cinnabar is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <Icon Id="cinnabar.ico" SourceFile="$(Icon)" />
    <Property Id="ARPPRODUCTICON" Value="cinnabar.ico" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Cinnabar">
        <!-- Layout: bedrock-client.exe and bedrock-core.exe beside a resources\ tree. -->
        <Files Include="$(Payload)\**" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="StartMenuShortcut" Guid="*">
        <Shortcut Id="AppShortcut" Name="Cinnabar" Target="[INSTALLFOLDER]bedrock-client.exe"
                  WorkingDirectory="INSTALLFOLDER" Icon="cinnabar.ico" />
        <RegistryValue Root="HKCU" Key="Software\Cinnabar" Name="shortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <Feature Id="Main" Title="Cinnabar" Level="1">
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>
  </Package>
</Wix>
