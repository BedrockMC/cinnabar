package cinnabar:extension@0.1.0;

/// A retained, plain-text label drawn by the host's JSON-UI engine.
interface hud {
    /// Replaces this mod's label. Empty text removes it; invalid text is rejected.
    set-label: func(text: string) -> result<_, string>;
}

/// An opt-in retained settings panel, rendered and hit-tested by the host.
interface panel {
    record event { id: string, value: f32 }
    /// Bounded panel JSON; empty text removes the panel and releases its input.
    set-content: func(json: string) -> result<_, string>;
}

/// Settings belong to the selected component's fixed companion file.
interface settings {
    load: func() -> result<string, string>;
    /// Stages bounded JSON for persistence after a successful callback.
    save: func(json: string) -> result<_, string>;
}

/// Local control edges, available only with explicit controls authority.
interface input {
    use panel.{event};
    record controls {
        seconds: f32,
        focused: bool,
        gameplay: bool,
        panel-open: bool,
        keys-pressed: list<string>,
        /// Physical keys held this frame, including reserved ones.
        keys-held: list<string>,
        events: list<event>,
    }
    /// True only for the current frame's host-assigned action edge.
    demo-pressed: func() -> bool;
    read-controls: func() -> result<controls, string>;
    /// Physical key names reserved before the ordinary gameplay router samples them.
    reserve-keys: func(keys: list<string>) -> result<_, string>;
}

/// Local presentation only; no world mutation or outbound packets.
interface environment {
    /// Fixes visual time to 0–23999 ticks; none restores the tracked server clock.
    set-time-override: func(ticks: option<u32>) -> result<_, string>;
}

/// Explicit local gameplay capabilities; no world mutation or packet access.
interface gameplay {
    record vector3 { x: f32, y: f32, z: f32 }
    /// Remote player feet in world coordinates, without names or network access.
    record player { runtime-id: u64, position: vector3 }
    /// Current input-owned frame only. Angles are actor YXZ radians: yaw left, pitch up.
    record snapshot {
        session: u64,
        dimension: s32,
        eye: vector3,
        yaw: f32,
        pitch: f32,
        attack-held: bool,
        frame-seconds: f32,
        players: list<player>,
    }
    /// Requires the explicit players grant; none means gameplay does not own input.
    read-frame: func() -> result<option<snapshot>, string>;
    /// Requires the camera grant and a current frame; commits only after frame returns.
    rotate: func(yaw-delta: f32, pitch-delta: f32) -> result<_, string>;
    /// Bounded local actor attack range; none restores ordinary game-mode rules.
    set-attack-reach: func(blocks: option<f32>) -> result<_, string>;
    /// One attack-press edge, only while the physical attack control is held.
    pulse-attack: func() -> result<_, string>;

    /// A nearby non-player actor; health comes from its replicated health attribute.
    record mob {
        runtime-id: u64,
        unique-id: s64,
        type-id: string,
        position: vector3,
        health: option<f32>,
        max-health: option<f32>,
    }
    /// Requires the entities grant and a current frame; nearest first, bounded by count and range.
    read-mobs: func() -> result<list<mob>, string>;

    /// Camera-local blocks (x right, y up, z back), roll in radians, FOV change in degrees.
    record camera-rig { offset: vector3, roll: f32, fov-delta: f32 }
    /// Retained third-person rig, swept against blocks; none restores the player's own view.
    set-camera-rig: func(rig: option<camera-rig>) -> result<_, string>;

    /// Sent as a player command request after frame returns; the command must be granted by name.
    request-command: func(command: string) -> result<_, string>;
}

/// Local presentation cues published to the host after frame returns; no authority.
interface events {
    emit: func(name: string, values: list<f32>) -> result<_, string>;
}

/// Experimental developer contract; no WASI or ambient operating-system access.
world extension {
    import hud;
    import input;
    import environment;
    import gameplay;
    import events;
    import panel;
    import settings;
    /// Creates the initial retained UI state.
    export init: func();
    /// Bounded frame callback used to measure the spike's crossing cost.
    export frame: func();
}

/// Server-scoped component; optional grants return denial through these imports.
world server-bundle {
    import cinnabar:server-experience/ui@1.0.0;
    import cinnabar:server-experience/input@1.0.0;
    import cinnabar:server-experience/messaging@1.0.0;
    import cinnabar:server-experience/scene@1.0.0;
    import cinnabar:server-experience/media@1.0.0;
    export init: func();
    /// A typed message or host-owned input edge; no raw packet or keyboard data.
    export dispatch: func(channel: string, record-json: list<u8>);
}
