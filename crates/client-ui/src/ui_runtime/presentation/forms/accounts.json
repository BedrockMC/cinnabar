{
  "namespace": "cinnabar_accounts",
  "row": {
    "type": "panel", "size": ["100%", 38],
    "controls": [
      {"select@common_buttons.light_text_button": {
        "size": ["100%", 36], "$button_text": "", "$pressed_button_name": "button.cinnabar_switch_account",
        "bindings": [{"binding_type": "collection", "binding_collection_name": "cinnabar_accounts", "binding_name": "#account_enabled", "binding_name_override": "#enabled"}]
      }},
      {"picture": {
        "type": "image", "size": [28, 28], "anchor_from": "left_middle", "anchor_to": "left_middle", "offset": [5, -1], "layer": 10,
        "texture": "#account_picture", "texture_file_system": "RawPath",
        "bindings": [{"binding_type": "collection", "binding_collection_name": "cinnabar_accounts", "binding_name": "#account_picture"}]
      }},
      {"name": {
        "type": "label", "size": ["100%-44px", 10], "anchor_from": "left_middle", "anchor_to": "left_middle", "offset": [39, -1], "layer": 10,
        "text": "#account_name", "text_alignment": "left", "color": [0.15, 0.15, 0.15],
        "bindings": [{"binding_type": "collection", "binding_collection_name": "cinnabar_accounts", "binding_name": "#account_name"}]
      }}
    ]
  },
  "list": {
    "type": "stack_panel", "orientation": "vertical", "size": ["100%", "100%c"],
    "collection_name": "cinnabar_accounts", "factory": {"name": "cinnabar_account_factory", "control_name": "cinnabar_accounts.row"},
    "bindings": [{"binding_name": "#account_count", "binding_name_override": "#collection_length"}]
  },
  "screen": {
    "type": "screen", "absorbs_input": true, "is_modal": true, "render_only_when_topmost": false,
    "button_mappings": [{"from_button_id": "button.menu_cancel", "to_button_id": "button.cinnabar_accounts_close", "mapping_type": "global"}],
    "controls": [
      {"scrim": {"type": "panel", "size": ["100%", "100%"], "fill": true, "color": [0, 0, 0, 0.6]}},
      {"dialog": {
        "type": "panel", "size": ["85%", "85%"], "max_size": [300, 280], "layer": 100,
        "controls": [
          {"background@popup_dialog.popup_dialog_bg": {"size": ["100%", "100%"]}},
          {"title": {"type": "label", "size": ["90%", 20], "anchor_from": "top_middle", "anchor_to": "top_middle", "offset": [0, 8], "layer": 110, "text": "Accounts", "color": [0.15, 0.15, 0.15]}},
          {"accounts@common.scrolling_panel": {
            "size": ["90%", "100%-120px"], "anchor_from": "top_middle", "anchor_to": "top_middle", "offset": [0, 32],
            "$scrolling_content": "cinnabar_accounts.list", "$scroll_pane_name": "cinnabar_accounts_pane", "$show_background": false,
            "bindings": [{"binding_name": "#accounts_ready", "binding_name_override": "#visible"}]
          }},
          {"status": {
            "type": "label", "size": ["85%", "100%-120px"], "anchor_from": "top_middle", "anchor_to": "top_middle", "offset": [0, 32], "layer": 110,
            "text": "#account_status", "color": [0.15, 0.15, 0.15],
            "bindings": [{"binding_name": "#account_status"}, {"binding_name": "#accounts_busy", "binding_name_override": "#visible"}]
          }},
          {"error": {"type": "label", "size": ["90%", 20], "anchor_from": "bottom_middle", "anchor_to": "bottom_middle", "offset": [0, -64], "text": "#account_error", "color": [0.7, 0.05, 0.05], "layer": 110, "bindings": [{"binding_name": "#account_error"}]}},
          {"add@common_buttons.light_text_button": {
            "size": ["90%", 24], "anchor_from": "bottom_middle", "anchor_to": "bottom_middle", "offset": [0, -36],
            "$button_text": "Add account", "$pressed_button_name": "button.cinnabar_add_account",
            "bindings": [{"binding_name": "#accounts_ready", "binding_name_override": "#visible"}]
          }},
          {"cancel@common_buttons.light_text_button": {
            "size": ["90%", 24], "anchor_from": "bottom_middle", "anchor_to": "bottom_middle", "offset": [0, -36],
            "$button_text": "Cancel sign-in", "$pressed_button_name": "button.cinnabar_cancel_account",
            "bindings": [{"binding_name": "#accounts_busy", "binding_name_override": "#visible"}]
          }},
          {"profile@common_buttons.light_text_button": {
            "size": ["44%", 24], "anchor_from": "bottom_left", "anchor_to": "bottom_left", "offset": ["5%", -8],
            "$button_text": "View profile", "$pressed_button_name": "button.cinnabar_view_profile",
            "bindings": [{"binding_name": "#accounts_ready", "binding_name_override": "#enabled"}]
          }},
          {"close@common_buttons.light_text_button": {
            "size": ["44%", 24], "anchor_from": "bottom_right", "anchor_to": "bottom_right", "offset": ["-5%", -8],
            "$button_text": "Close", "$pressed_button_name": "button.cinnabar_accounts_close"
          }}
        ]
      }}
    ]
  }
}
